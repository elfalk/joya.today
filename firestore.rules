rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(id) {
      return id is string && id.size() >= 5 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_.+\\-@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function isSuperAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'yuoseef01102@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidSystem(data) {
      return data.keys().hasAll([
          'id', 'name', 'slug', 'category', 'order', 'color',
          'shortDesc', 'description', 'features', 'status',
          'platforms', 'downloadUrl', 'packages', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'slug', 'category', 'order', 'color',
          'shortDesc', 'description', 'features', 'status',
          'platforms', 'downloadUrl', 'logoUrl', 'packages', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 100
        && data.category in ['core', 'additional']
        && data.order is int && data.order >= 1 && data.order <= 500
        && data.color is string && data.color.size() == 7 && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.shortDesc is string && data.shortDesc.size() >= 2 && data.shortDesc.size() <= 300
        && data.description is string && data.description.size() >= 2 && data.description.size() <= 3000
        && data.features is list && data.features.size() <= 15 && (data.features.size() == 0 || data.features[0] is string)
        && data.status in ['available', 'coming_soon']
        && data.platforms is list && data.platforms.size() >= 1 && data.platforms.size() <= 4
        && data.platforms.hasOnly(['windows', 'android', 'ios', 'web'])
        && data.downloadUrl is string && data.downloadUrl.size() <= 500
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 350000))
        && data.packages is list && data.packages.size() <= 10
        && (data.packages.size() == 0 || (
          data.packages[0] is map &&
          data.packages[0].name is string &&
          data.packages[0].price is number
        ));
    }

    function isValidLeadCreate(data) {
      return data.keys().hasAll([
          'id', 'fullName', 'businessName', 'phone', 'governorate',
          'systemId', 'systemName', 'requestType', 'followUpStatus', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'fullName', 'businessName', 'phone', 'governorate',
          'systemId', 'systemName', 'requestType', 'packageId', 'packageName',
          'followUpStatus', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 160
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30
        && data.governorate is string && data.governorate.size() >= 2 && data.governorate.size() <= 80
        && isValidId(data.systemId)
        && data.systemName is string && data.systemName.size() >= 2 && data.systemName.size() <= 120
        && data.requestType in ['download', 'purchase', 'preorder']
        && data.followUpStatus == 'new'
        && (!('packageId' in data) || (data.packageId is string && data.packageId.size() <= 128))
        && (!('packageName' in data) || (data.packageName is string && data.packageName.size() <= 160))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidLeadUpdate(data) {
      return data.keys().hasAll([
          'id', 'fullName', 'businessName', 'phone', 'governorate',
          'systemId', 'systemName', 'requestType', 'followUpStatus', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'fullName', 'businessName', 'phone', 'governorate',
          'systemId', 'systemName', 'requestType', 'packageId', 'packageName',
          'followUpStatus', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.followUpStatus in ['new', 'contacted', 'converted', 'archived']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'displayName', 'role', 'addedBy', 'createdAt'])
        && isValidEmailId(data.email)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100
        && data.role in ['super_admin', 'sub_admin']
        && (!('addedBy' in data) || (data.addedBy is string && data.addedBy.size() <= 160));
    }

    function isValidSocialUrl(val) {
      return val is string && val.size() <= 500 && (val == '' || val.matches('^https?://.+'));
    }

    function isValidSocialSettings(data) {
      return data.keys().hasAll([
          'youtube', 'facebook', 'tiktok', 'linkedin', 'instagram', 'whatsapp', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'youtube', 'facebook', 'tiktok', 'linkedin', 'instagram', 'whatsapp', 'updatedAt'
        ])
        && isValidSocialUrl(data.youtube)
        && isValidSocialUrl(data.facebook)
        && isValidSocialUrl(data.tiktok)
        && isValidSocialUrl(data.linkedin)
        && isValidSocialUrl(data.instagram)
        && isValidSocialUrl(data.whatsapp);
    }

    // 4. Collection Rules
    match /systems/{systemId} {
      allow get, list: if true;
      allow create: if isAdmin()
        && isValidId(systemId)
        && isValidSystem(incoming())
        && incoming().id == systemId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(systemId)
        && isValidSystem(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'category', 'order', 'color',
          'shortDesc', 'description', 'features', 'status',
          'platforms', 'downloadUrl', 'logoUrl', 'packages', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(systemId);
    }

    match /leads/{leadId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(leadId)
        && isValidLeadCreate(incoming())
        && incoming().id == leadId
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(leadId)
        && isValidLeadUpdate(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'followUpStatus', 'notes', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(leadId);
    }

    match /admins/{adminEmail} {
      allow get: if isValidEmailId(adminEmail) && (
        isAdmin() || (isVerified() && adminEmail == request.auth.token.email.lower())
      );
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidEmailId(adminEmail)
        && isValidAdmin(incoming())
        && incoming().email == adminEmail
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidEmailId(adminEmail)
        && isValidAdmin(incoming())
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'role', 'addedBy'
        ]);
      allow delete: if isAdmin()
        && isValidEmailId(adminEmail)
        && adminEmail != 'yuoseef01102@gmail.com';
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'social';
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(settingId)
        && settingId == 'social'
        && isValidSocialSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(settingId)
        && settingId == 'social'
        && isValidSocialSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'youtube', 'facebook', 'tiktok', 'linkedin', 'instagram', 'whatsapp', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
